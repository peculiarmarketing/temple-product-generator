{%- comment -%}
  Peculiar People homepage: spec overlay. A photo with callouts: a small dot on the
  photo and a label away from it, joined by a thin line that draws out when the
  section scrolls into view. Each callout is a block (point on the photo, desktop
  side, phone place, small caps label, short line). Desktop puts the labels in
  columns either side of the photo; phones put them in two rows above and below a
  full-width photo. pp-quality.js draws the lines on both. Each callout's dot can be
  hidden, and its line can go to its label, to a point placed with the line-end
  sliders (desktop and phones set apart, in % of the photo, past its edges allowed),
  or nowhere; "Show callout dots and lines" turns them all off. The photo keeps its own
  shape. An optional note sits under the photo (the guarantee and delivery line).
  With the script off or reduced motion on, the labels and dots are simply shown.

  Phone bands (below 990px): every temple's art drifts to the right above the labels
  and every city map's art drifts to the left below them, each drawing with its city
  underlined beneath it. From 990px wide ("Bands behind the photo on desktop") the
  same two bands run the full width of the window behind the top and bottom of the
  photo, so they come out either side of it and add no height. The photo grows with
  the window there (up to 960px). Each band is 1 / (2 + golden ratio squared) of the
  photo's height and the labels sit evenly in the middle part between them, which is
  the golden ratio squared times a band. The bands are scroll areas that
  assets/pp-bands.js moves, so a visitor can also swipe either way. "Drawing colour"
  black inverts the white-ink art for a light background. A tile links to every product from its place: /search?view=place with the
  place line ("Provo, Utah") as the search terms, which templates/search.place.json
  turns into the temples and maps whose `peculiar.temple_city` and `temple_state`
  match (sections/pp-place-results.liquid). A temple shows
  once its city line is in snippets/pp-temple-city.liquid, the same rule as the
  homepage marquee; a map shows once it is in the map collection. With no collection
  picked, temples come from temple-tees and maps from church-history-maps.
{%- endcomment -%}
{{ 'pp-quality.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-quality.js' | asset_url }}" defer></script>
<script src="{{ 'pp-bands.js' | asset_url }}" defer></script>
{%- render 'pp-quality-font' -%}
{%- liquid
  assign s = section.settings
  assign image_alt = s.image.alt | default: 'Four friends in the bomber jacket, the hoodie, the sweatshirt and the tee'
  assign image_ratio = s.image.aspect_ratio | default: 1.5
  assign left_count = 0
  assign right_count = 0
  for block in section.blocks
    if block.settings.side == 'left'
      assign left_count = left_count | plus: 1
    else
      assign right_count = right_count | plus: 1
    endif
  endfor
  assign rows = left_count
  if right_count > rows
    assign rows = right_count
  endif
  if rows < 1
    assign rows = 1
  endif

  assign bands = s.phone_bands | default: 'none'
  assign temple_source = s.temple_collection | default: collections['temple-tees']
  assign map_source = s.map_collection | default: collections['church-history-maps']
-%}

{%- if bands != 'none' -%}
  {%- comment -%}
    One entry per temple and per map: `temples` and `maps` hold
    "slug^name^place" for the tiles, place being "City, State".
  {%- endcomment -%}
  {%- liquid
    assign temples = ''
    assign maps = ''
    assign seen = ','
  -%}
  {%- if temple_source != blank -%}
    {%- paginate temple_source.products by 250 -%}
      {%- liquid
        for product in temple_source.products
          assign slug = ''
          for tag in product.tags
            assign head = tag | slice: 0, 7
            if head == 'temple:'
              assign slug = tag | remove_first: 'temple:'
              break
            endif
          endfor
          assign needle = ',t:' | append: slug | append: ','
          assign city = ''
          if slug != blank
            unless seen contains needle
              capture city
                render 'pp-temple-city', slug: slug
              endcapture
            endunless
          endif
          if city != blank
            assign seen = seen | append: 't:' | append: slug | append: ','
            assign place = product.metafields.peculiar.temple_city.value
            if product.metafields.peculiar.temple_state.value != blank
              assign place = place | append: ', ' | append: product.metafields.peculiar.temple_state.value
            endif
            assign name = product.metafields.peculiar.temple_name.value | default: product.title
            assign temples = temples | append: slug | append: '^' | append: name | append: '^' | append: place | append: '~'
          endif
        endfor
      -%}
    {%- endpaginate -%}
  {%- endif -%}
  {%- if map_source != blank -%}
    {%- paginate map_source.products by 250 -%}
      {%- liquid
        for product in map_source.products
          assign slug = ''
          for tag in product.tags
            assign head = tag | slice: 0, 4
            if head == 'map:'
              assign slug = tag | remove_first: 'map:'
              break
            endif
          endfor
          assign needle = ',m:' | append: slug | append: ','
          if slug != blank
            unless seen contains needle
              assign seen = seen | append: 'm:' | append: slug | append: ','
              assign name = product.metafields.peculiar.temple_city.value | default: slug
              assign place = product.metafields.peculiar.temple_city.value
              if product.metafields.peculiar.temple_state.value != blank
                assign place = place | append: ', ' | append: product.metafields.peculiar.temple_state.value
              endif
              assign maps = maps | append: slug | append: '^' | append: name | append: '^' | append: place | append: '~'
            endunless
          endif
        endfor
      -%}
    {%- endpaginate -%}
  {%- endif -%}

  {%- comment -%} Second pass: the tiles, each with its place link. {%- endcomment -%}
  {%- assign temple_count = 0 -%}
  {%- capture temple_items -%}
    {%- assign rows_t = temples | split: '~' -%}
    {%- for row in rows_t -%}
      {%- liquid
        assign f = row | split: '^'
        assign slug = f[0]
        assign name = f[1]
        assign place = f[2]
        assign temple_count = temple_count | plus: 1
        assign art = 'pp-temple-' | append: slug | append: '.webp' | asset_url
      -%}
      <li class="pp-spec__tile pp-spec__tile--temple">
        <a class="pp-spec__tile-link" href="{{ routes.search_url }}?view=place&q={{ place | url_encode }}" aria-label="{{ name | escape }}. Shop everything from {{ place | escape }}">
          <img src="{{ art }}" alt="" width="420" height="352" loading="lazy" decoding="async">
          <span class="pp-spec__tile-city">{{ place | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign map_count = 0 -%}
  {%- capture map_items -%}
    {%- assign rows_m = maps | split: '~' -%}
    {%- for row in rows_m -%}
      {%- liquid
        assign f = row | split: '^'
        assign slug = f[0]
        assign name = f[1]
        assign place = f[2]
        assign map_count = map_count | plus: 1
        assign art = 'pp-map-' | append: slug | append: '.webp' | asset_url
      -%}
      <li class="pp-spec__tile pp-spec__tile--map">
        <a class="pp-spec__tile-link" href="{{ routes.search_url }}?view=place&q={{ place | url_encode }}" aria-label="{{ name | escape }} map. Shop everything from {{ place | escape }}">
          <img src="{{ art }}" alt="" width="315" height="420" loading="lazy" decoding="async">
          <span class="pp-spec__tile-city">{{ place | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<section
  class="pp-spec{% if bands != 'none' %} pp-spec--bands{% if s.desktop_bands %} pp-spec--desk-bands{% endif %}{% if s.art_ink == 'black' %} pp-spec--ink-black{% endif %}{% endif %}"
  data-pp-spec
  style="--pp-spec-bg: {{ s.background }}; --pp-spec-fg: {{ s.text_color }}; --pp-spec-accent: {{ s.accent }}; --pp-spec-rows: {{ rows }}; --pp-spec-ar: {{ image_ratio }};{% if bands != 'none' %} --pp-band-h: {{ s.band_height }}px; --pp-desk-band: {{ s.desk_band_size | default: 22 }};{% endif %}"
>
  <div class="pp-spec__inner">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="pp-spec__intro">
        {%- if s.heading != blank -%}
          <h2 class="pp-spec__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="pp-spec__text">{{ s.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pp-spec__stage" data-pp-spec-stage>
      {%- if bands != 'none' and temple_count > 0 -%}
        <div class="pp-spec__band pp-spec__band--top" data-pp-band data-dir="right" data-seconds="{{ s.band_seconds }}" role="region" aria-label="{{ s.temple_band_label | escape }}">
          <div class="pp-spec__band-view" data-pp-band-view>
            <ul class="pp-spec__band-list" role="list" data-pp-band-list>{{ temple_items }}</ul>
            <ul class="pp-spec__band-list pp-spec__band-list--copy" role="list" aria-hidden="true" data-pp-band-copy>{{ temple_items }}</ul>
          </div>
        </div>
      {%- endif -%}

      <div class="pp-spec__media">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1920
            | image_tag:
              loading: 'lazy',
              widths: '550, 750, 1000, 1400, 1920',
              sizes: '(min-width: 990px) 960px, 100vw',
              class: 'pp-spec__img',
              alt: image_alt
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'pp-spec__img pp-spec__img--placeholder' }}
        {%- endif -%}
        {%- if s.show_callouts -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign line = b.line | default: 'label'
              if b.show_dot == false and line == 'none'
                continue
              endif
            -%}
            <span
              class="pp-spec__dot{% if b.show_dot == false %} pp-spec__dot--hidden{% endif %}"
              style="--x: {{ b.x }}%; --y: {{ b.y }}%;"
              data-pp-spec-dot="{{ forloop.index }}"
              data-line="{{ line }}"
              data-end="{{ b.end_x }},{{ b.end_y }}"
              data-end-phone="{{ b.end_x_phone }},{{ b.end_y_phone }}"
              aria-hidden="true"
            ></span>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%}
        Labels grouped by side. On phones and narrow desktops the group box is
        display: contents and each label takes its own grid cell (--r is its row on
        desktop); with the desktop bands the group is one column between the bands
        that spaces its labels evenly. --i and the label number keep block order.
      {%- endcomment -%}
      {%- assign sides = 'left,right' | split: ',' -%}
      {%- for side in sides -%}
        {%- assign side_row = 0 -%}
        <div class="pp-spec__side pp-spec__side--{{ side }}">
          {%- for block in section.blocks -%}
            {%- assign block_side = block.settings.side | default: 'right' -%}
            {%- if block_side != side -%}{%- continue -%}{%- endif -%}
            {%- assign side_row = side_row | plus: 1 -%}
            <div
              class="pp-spec__label pp-spec__label--{{ side }} pp-spec__label--{{ block.settings.phone | default: 'below' }}{% if block.settings.eyebrow == blank and block.settings.label == blank %} pp-spec__label--empty{% endif %}"
              style="--i: {{ forloop.index0 }}; --r: {{ side_row }};"
              data-pp-spec-label="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <span class="pp-spec__words">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="pp-spec__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="pp-spec__sub">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}

      {%- if bands != 'none' and map_count > 0 -%}
        <div class="pp-spec__band pp-spec__band--bottom" data-pp-band data-dir="left" data-seconds="{{ s.band_seconds }}" role="region" aria-label="{{ s.map_band_label | escape }}">
          <div class="pp-spec__band-view" data-pp-band-view>
            <ul class="pp-spec__band-list" role="list" data-pp-band-list>{{ map_items }}</ul>
            <ul class="pp-spec__band-list pp-spec__band-list--copy" role="list" aria-hidden="true" data-pp-band-copy>{{ map_items }}</ul>
          </div>
        </div>
      {%- endif -%}

      <svg class="pp-spec__lines" aria-hidden="true" focusable="false" data-pp-spec-lines></svg>
    </div>

    {%- if s.note != blank -%}
      {%- comment -%}
        The note as a letter: its first paragraph is the lead, the rest the body, the
        last paragraph (the sign-off) set as a signature line. Words untouched.
      {%- endcomment -%}
      {%- liquid
        assign lead = ''
        assign rest = s.note
        if s.note contains '</p>'
          assign lead = s.note | split: '</p>' | first | append: '</p>'
          assign rest = s.note | remove_first: lead | strip
        endif
      -%}
      <div class="pp-spec__note{% if lead != blank and rest != blank %} pp-spec__note--letter{% endif %}">
        {%- if lead != blank -%}<div class="pp-spec__lead">{{ lead }}</div>{%- endif -%}
        {%- if rest != blank -%}<div class="pp-spec__body">{{ rest }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PP spec overlay",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text under the heading" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Any shape; it is shown whole. After changing it, move each callout's point to match."
    },
    { "type": "richtext", "id": "note", "label": "Note under the photo" },
    { "type": "color", "id": "background", "label": "Background", "default": "#0d0e11" },
    { "type": "color", "id": "text_color", "label": "Text and lines", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Dot colour", "default": "#F58000" },
    {
      "type": "checkbox",
      "id": "show_callouts",
      "label": "Show callout dots and lines",
      "default": true,
      "info": "Off hides every dot and line. Each callout can also hide its own dot or line."
    },
    { "type": "header", "content": "Temple and map bands" },
    {
      "type": "select",
      "id": "phone_bands",
      "label": "Temple and map bands on phones",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "stack", "label": "Above and below the labels" }
      ],
      "default": "stack",
      "info": "Temples drift right above the labels, maps drift left below them; visitors can swipe either way. Every drawing links to all products from its place."
    },
    {
      "type": "checkbox",
      "id": "desktop_bands",
      "label": "Bands behind the photo on desktop",
      "default": true,
      "info": "990px and wider: the same bands run behind the top and bottom of the photo and come out either side. Visitors can drag or scroll them."
    },
    {
      "type": "select",
      "id": "art_ink",
      "label": "Drawing colour",
      "options": [
        { "value": "white", "label": "White (dark background)" },
        { "value": "black", "label": "Black (light background)" }
      ],
      "default": "white"
    },
    { "type": "collection", "id": "temple_collection", "label": "Temples from", "info": "Empty uses Marquee: designed temples (temple-tees), the collection the homepage marquee reads. Each temple shows once." },
    { "type": "collection", "id": "map_collection", "label": "Maps from", "info": "Empty uses Church History Maps." },
    { "type": "range", "id": "band_height", "label": "Phone band height", "min": 140, "max": 260, "step": 10, "unit": "px", "default": 190, "info": "Phones only. Drawing plus its city line." },
    { "type": "range", "id": "desk_band_size", "label": "Desktop band height", "min": 10, "max": 40, "step": 1, "unit": "%", "default": 22, "info": "Desktop only, as a share of the photo's height. 22% is the golden-ratio split: band, gap, band." },
    { "type": "range", "id": "band_seconds", "label": "Seconds each drawing takes to drift past", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "temple_band_label", "label": "Temple band name for screen readers", "default": "Shop by temple" },
    { "type": "text", "id": "map_band_label", "label": "Map band name for screen readers", "default": "Shop by Church history site" }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Small caps label", "default": "Spec" },
        { "type": "text", "id": "label", "label": "Line under it" },
        {
          "type": "select",
          "id": "side",
          "label": "Label side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "right",
          "info": "Desktop: the column the label sits in. Phones: left or right half of its row."
        },
        {
          "type": "select",
          "id": "phone",
          "label": "On phones",
          "options": [
            { "value": "above", "label": "Above the photo" },
            { "value": "below", "label": "Below the photo" }
          ],
          "default": "below",
          "info": "Use one left and one right callout per row."
        },
        { "type": "header", "content": "Dot" },
        { "type": "checkbox", "id": "show_dot", "label": "Show dot", "default": true },
        { "type": "range", "id": "x", "label": "Dot across the photo (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Dot down the photo (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "header", "content": "Line" },
        {
          "type": "select",
          "id": "line",
          "label": "Line goes to",
          "options": [
            { "value": "label", "label": "Its label" },
            { "value": "point", "label": "A point I place" },
            { "value": "none", "label": "No line" }
          ],
          "default": "label",
          "info": "\"Its label\" draws nothing when the callout has no words. \"A point I place\" uses the sliders below; under 0 or over 100 runs past the photo's edge."
        },
        { "type": "range", "id": "end_x", "label": "Desktop: line end across the photo (%)", "min": -50, "max": 150, "step": 2, "default": -20 },
        { "type": "range", "id": "end_y", "label": "Desktop: line end down the photo (%)", "min": -50, "max": 150, "step": 2, "default": 50 },
        { "type": "range", "id": "end_x_phone", "label": "Phones: line end across the photo (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "end_y_phone", "label": "Phones: line end down the photo (%)", "min": -50, "max": 150, "step": 2, "default": 110 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PP spec overlay",
      "blocks": [
        { "type": "callout", "settings": { "eyebrow": "Hoodie · 350 GSM", "label": "Heavy fleece, 10.3 oz.", "side": "left", "phone": "above", "x": 21, "y": 65 } },
        { "type": "callout", "settings": { "eyebrow": "Designed and printed in the USA", "label": "We print yours after you order. It arrives in 4 to 7 business days.", "side": "right", "phone": "above", "x": 87, "y": 53 } },
        { "type": "callout", "settings": { "eyebrow": "Tee · 260 GSM", "label": "Heavyweight cotton that's soft from the first wear.", "side": "left", "phone": "below", "x": 50, "y": 69 } },
        { "type": "callout", "settings": { "eyebrow": "Crewneck · 350 GSM", "label": "Same fleece as the hoodie.", "side": "right", "phone": "below", "x": 86, "y": 69 } }
      ]
    }
  ]
}
{% endschema %}
