.env
.venv*/
__pycache__/
*.pyc
.DS_Store
.playwright*/

# Regenerable review output. scripts/tapstitch_preview.py rebuilds the whole
# sheet in about seven minutes, and it is rebuilt on every spacing change, so
# committing ~6MB of PNGs each time would bloat history for no gain. The
# published artifact is the shareable copy.
artifacts/tapstitch-previews/

# Regenerable print output, same reasoning as the proof sheet. The three front
# logo files are rebuilt by every tapstitch_build.py run, and the 135 back print
# files are not here at all: they are written into each temple's own folder under
# Temples/, which is outside this repo. Committing one half of a generated pair
# would be worse than committing neither.
artifacts/tapstitch/front-logo/

# Captured Tapstitch editor traffic. Recorded by scripts/tapstitch_capture.py to
# work out how the editor saves a design. Redacted at capture time, but a body
# can still carry account detail, so it never goes in git.
artifacts/tapstitch/network/

# On-model photo mockup spike. The PNG originals of the base and colourway
# photos are 96MB; artifacts/photo-mockup-spike/source-photos/ holds the same 19
# images as quality-95 JPEG at 15MB, which is the recoverable copy. The PNGs
# stay on disk (this workspace is in iCloud) but do not belong in history, for
# the same reason the proof sheet and print files above do not.
artifacts/photo-mockup-spike/bases/
# final-set IS tracked on purpose: scripts/build_product_gallery.py uploads
# from it, so the process cannot run on a fresh clone without it (7MB).
# colourway-photos and bases stay out at 59MB and 15MB; they are only needed
# to re-composite a NEW temple, which also needs ../../Temples/ anyway.
artifacts/photo-mockup-spike/colourway-photos/
artifacts/photo-mockup-spike/model_blank.png

# Rebuilt from source-photos plus composite_set.py in about 16 seconds.

# Re-downloadable from Tapstitch. STATE.md records the URL scheme: the version
# number in a Tapstitch filename is a unix timestamp and the folder it sits in
# is that timestamp's date, which recovers any asset from its filename alone.
artifacts/photo-mockup-spike/tapstitch-on-model/

# download cache for the flat-mockup classifier, regenerates itself
artifacts/photo-mockup-spike/.flatcache/

# Normalized gallery images are derived at upload time from tracked sources
# (fabric-details/, the flats archived in flat-originals/) plus the per-garment
# grays in backdrop_grays.json. Committing them would add tens of megabytes of
# output that a single constant change invalidates.
artifacts/photo-mockup-spike/normalized/
artifacts/photo-mockup-spike/normalize-preview/

# Catalogue flat originals: 440 PNGs, about 220MB, and unlike the Salt Lake
# archive these are recoverable. Tapstitch can republish them from the print
# files in ../Temples/. Kept on disk before any delete, out of git.
artifacts/photo-mockup-spike/flat-originals/catalog/
artifacts/photo-mockup-spike/.flatcache/catalog/

# settings_data.json snapshots taken by scripts/swatches.py push before it writes
# the live theme. Kept on disk as the revert path for a bad swatch list, out of
# git for the same reason the captured editor traffic above is: the file carries
# the Shrine theme's own licence blobs, and a new timestamped copy lands on every
# push, so history would accumulate them for no gain.
artifacts/swatches/

# Pen-drawing theme assets, rebuilt from ../Temples/ by scripts/web_drawings.py build
# in about four minutes. The live theme holds the published copy. build-report.json
# is small and records the per-temple numbers, but it lives with the files it describes.
artifacts/web_drawings/

# Page-layout backups written by scripts/pen_templates.py golive, the revert path.
artifacts/pen_templates/

# Centred print files from before the one-quarter lift (7 Oct 2026), the revert
# path for the back prints. Out of git: 73MB of regenerable PNGs.
artifacts/tapstitch/print-backup-centred-2026-10-07/

# On-model composites for the one-quarter lift with fold option C (7 Oct 2026),
# the --composites folder for build_garment_catalog.py. Regenerable.
artifacts/photo-mockup-spike/composites-lift/

# Relift rollout working files: pre-save gallery thumbnails the alt-text restore
# matches against, and the pilot's downloaded mockups. Regenerable, out of git.
artifacts/tapstitch/relift-thumbs/
artifacts/tapstitch/pilot-monticello-tee/*.png
artifacts/tapstitch/pilot-monticello-tee/storeproducts_*.json

# on-model work files: the committed copies are onmodel-front/blanks/*.jpg and final/*.jpg
artifacts/onmodel-front/**/*.png
!artifacts/onmodel-front/prints/*.png

# v2 on-model work (8 Oct 2026): finals rebuild from blanks + composite_front_v2.py;
# flats are Tapstitch's store images; gen/ PNGs are the raw kie.ai outputs (blanks/ keeps the 4K copies)
artifacts/onmodel-v2/final/
artifacts/onmodel-v2/flats/
artifacts/onmodel-v2/gen/**/*.png

# Map print files, rebuilt by scripts/map_run.py from designs/city-map-back/out/.
artifacts/maps/*/*.png

# Raw Higgsfield output for the homepage quality sections (about 5 MB per PNG).
# The upload-ready JPEGs in artifacts/quality-sections/upload/ are the copies kept;
# generated/README.md records the jobs and settings to regenerate them.
artifacts/quality-sections/generated/*.png
artifacts/quality-sections/zoom-v2/**/*.png
!artifacts/quality-sections/zoom-v2/pp-logo-white.png
__pycache__/
artifacts/quality-sections/zoom-v2/**/*.mp4

# Homepage prototypes (9 Oct 2026): copies of theme assets and CDN files, and the raw
# generated textures and hoodie edits (their finished versions are in theme/assets).
artifacts/homepage-proto/img/
artifacts/homepage-proto/draw/
artifacts/homepage-proto/gen/
